# Renombra este archivo a .env y rellena solo las claves que quieras usar.
# Sin ninguna clave, el programa funciona con Yahoo Finance.

# Necesaria solo para --provider alpha_vantage.
ALPHA_VANTAGE_API_KEY=

# Opcional: ruta persistente compartida por todos los procesos que usen esa clave.
# Por defecto: ~/.local/state/miax/alpha-vantage.sqlite3 (independiente de la caché).
# No borrar el registro para reiniciar la cuota ni usar rutas distintas para la misma clave.
# ALPHA_VANTAGE_USAGE_DB=/ruta/persistente/alpha-vantage.sqlite3

# Opcional: clave de FRED, que da acceso a ALFRED. Añade al informe inflación, tipo de
# interés y las ratios de Sharpe y Sortino, con los datos tal como se publicaron.
FRED_API_KEY=
