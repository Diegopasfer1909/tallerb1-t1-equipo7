%% Realización estructural: Yahoo/Alpha satisfacen Protocol sin herencia explícita.
classDiagram
    direction TB
    accTitle: B1-T1 · Contrato y adaptadores de proveedores
    accDescr: Protocolo de precios, adaptadores Yahoo y Alpha, proveedores FRED y BCE, cliente HTTP y cuota persistente.
    class PriceProvider {
        <<Protocol · ports>>
        +get_prices(symbol, start, end, adjusted) PriceHistory
    }
    class IndicatorProvider {
        <<Protocol · ports>>
        +get_series(series_id, start, end) EconomicIndicator
    }
    class YahooFinanceAPI {
        +include_info : bool
        +cache_ttl : float
        +get_prices(symbol, start, end, adjusted) PriceHistory
        +get_info(symbol) dict
    }
    class AlphaVantageAPI {
        +outputsize : str
        +allow_partial : bool
        +include_info : bool
        +get_prices(symbol, start, end, adjusted) PriceHistory
        +get_info(symbol) dict
    }
    class FredAPI {
        +get_series(series_id, start, end) EconomicIndicator
    }
    class EcbAPI {
        +cache_ttl : float
        +session : curl_cffi
        +get_series(series_id, start, end) EconomicIndicator
    }
    class ApiClient {
        +cache_ttl : float
        +min_interval : float
        +before_request : Callable?
        +on_rejection : Callable?
        +get_json(url, params) dict
    }
    class AlphaVantageQuota {
        +path : Path
        +key_hash : str
        -_blocked_until : float
        +reserve()
        +handle_rejection(status, reason)
    }
    class curl_cffi {
        <<library>>
        +requests.get(url, params, timeout)
    }
    class Session {
        <<requests>>
        +get(url, params, timeout, allow_redirects)
    }
    YahooFinanceAPI ..|> PriceProvider
    AlphaVantageAPI ..|> PriceProvider
    FredAPI ..|> IndicatorProvider
    EcbAPI ..|> IndicatorProvider
    AlphaVantageAPI "1" *-- "1" ApiClient : client creado
    AlphaVantageAPI "1" *-- "1" AlphaVantageQuota : quota creada
    FredAPI "1" *-- "1" ApiClient : client creado
    EcbAPI ..> curl_cffi : descarga SDMX
    ApiClient "0..*" --> "1" Session : session propia o inyectada
    ApiClient ..> AlphaVantageQuota : callbacks inyectados por Alpha
    note for PriceProvider "Los puertos viven en src/ports.py (núcleo).\nmain crea los adaptadores; los cargadores solo los reciben."
    note for EcbAPI "Sin clave. CSV del BCE con curl_cffi.\nNo utiliza ApiClient; comparte la caché."
    note for YahooFinanceAPI "yfinance.Ticker y funciones de caché.\nNo utiliza ApiClient."
    note for AlphaVantageQuota "SQLite independiente de la caché.\n25 reservas / ventana móvil de 24 h.\nHash de clave y marcas temporales."
    note for ApiClient "Caché → ritmo → callback → HTTP.\nFRED no instala callbacks de cuota.\nYahoo y BCE no utilizan ApiClient."
%% Excepciones reales (no confundidas con el contrato):
%% ValueError <|-- PortfolioError <|-- ConfigurationError
%% RuntimeError <|-- ProviderError <|-- DataCoverageError (en errors, parte del contrato)
%% ProviderError <|-- AlphaVantageQuotaError (retry_at, remote)
