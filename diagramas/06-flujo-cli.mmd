%% Actividad UML expresada con flowchart: acciones, decisiones, inicio y finales.
%% Las salidas 0/1/2 son códigos del proceso. Los errores de run se agrupan.
%%{init: {"flowchart":{"curve":"linear","nodeSpacing":35,"rankSpacing":40}}}%%
flowchart TD
    accTitle: B1-T1 · Actividad de la interfaz de consola
    accDescr: Validación previa, descarga, simulación opcional, referencias del informe y salidas solicitadas.
    START((" "))
    ENV["Cargar .env<br/>sin sobrescribir el entorno"]
    PARSE["parse_arguments()<br/>validar opciones → RunConfig"]
    EXIT2((("2")))
    START --> ENV --> PARSE
    PARSE -->|"opciones inválidas: argparse"| EXIT2
    subgraph RUN["run(config) · coordinación"]
        KEYS{"¿Clave del proveedor<br/>elegido disponible?"}
        FRED{"¿--report y falta<br/>FRED_API_KEY?"}
        WARN["Aviso: faltan referencias FRED<br/>el informe continúa"]
        FX{"¿--currency?"}
        FXP["Crear YahooFinanceAPI auxiliar<br/>para cambios necesarios"]
        LOAD["load_portfolio() · --assets<br/>load_portfolio_from_shares() · --shares<br/>precios → activos → FX → cartera"]
        PRINT["print_portfolio()"]
        SIMQ{"¿config.simulation<br/>es distinto de None?"}
        SIM["portfolio.monte_carlo()<br/>print_simulation()"]
        OUT{"¿--report o<br/>--plots-report?"}
        REFQ{"¿--report?"}
        REFS["load_references()<br/>benchmark · inflación · tipo<br/>fallos opcionales → Notice"]
        ANALYZE["portfolio.analyze(references)<br/>PortfolioAnalysis"]
        REPORTQ{"¿--report?"}
        REPORT["analysis.report(simulation)<br/>carpeta temporal → Markdown + PNG<br/>renombrar al completar"]
        PLOTQ{"¿--plots-report?"}
        PLOTS["show_plots()<br/>análisis y simulación disponible"]
        KEYS -->|"sí"| FRED
        FRED -->|"sí"| WARN
        FRED -->|"no"| FX
        WARN --> FX
        FX -->|"sí"| FXP
        FX -->|"no"| LOAD
        FXP --> LOAD
        LOAD --> PRINT --> SIMQ
        SIMQ -->|"sí"| SIM
        SIMQ -->|"no"| OUT
        SIM --> OUT
        OUT -->|"sí"| REFQ
        REFQ -->|"sí"| REFS
        REFQ -->|"no: references=None"| ANALYZE
        REFS --> ANALYZE
        ANALYZE --> REPORTQ
        REPORTQ -->|"sí"| REPORT
        REPORTQ -->|"no"| PLOTQ
        REPORT --> PLOTQ
        PLOTQ -->|"sí"| PLOTS
    end
    PARSE -->|"configuración válida"| KEYS
    ERR["Mensaje por stderr"]
    EXIT1((("1")))
    OK((("0")))
    KEYS -->|"no: ConfigurationError"| ERR
    RUN -. "PortfolioError · ProviderError · OSError" .-> ERR
    ERR --> EXIT1
    OUT -->|"no"| OK
    PLOTQ -->|"no"| OK
    PLOTS --> OK
    NOTE["Simulación activada por --simulate<br/>o por --report con sección simulation.<br/>El informe por defecto incluye esa sección."]
    NOTE -.- SIMQ
%% Las descargas de referencias ocurren después de la simulación en la CLI.
%% Un fallo del proveedor elegido no activa otro proveedor automáticamente.
%% --help termina mediante argparse con código 0; no entra en run.
