%% Las dependencias de uso/creación no son herencia.
classDiagram
    direction LR
    accTitle: B1-T1 · Abstracción compartida de simulación
    accDescr: Asset y Portfolio preparan SimulationInputs y delegan en simulate sin superclase común.
    class Asset {
        +simulation_inputs(price_column) SimulationInputs
        +monte_carlo(settings, options) SimulationResult
    }
    class Portfolio {
        +rebalance_rule : RebalanceRule
        +simulation_inputs(price_column, estimation_prices) SimulationInputs
        +monte_carlo(settings, estimation_prices, options) SimulationResult
    }
    class SimulationInputs {
        <<frozen dataclass>>
        +prices : DataFrame
        +starting_values : Series
        +currency : str
        +price_column : str
        +rebalance_weights : Series?
        +rebalance_rule : RebalanceRule
        +equity_shares : Series?
    }
    class SimulationSettings {
        <<frozen dataclass>>
        +steps : int?
        +simulations : int
        +seed : int?
        +confidence : float
        +expected_returns : Assumption
        +volatilities : Assumption
        +equity_premium : float
        +risk_free_rate : float?
        +from_options(settings, options) SimulationSettings$
    }
    class monte_carlo {
        <<module>>
        +simulate(inputs, settings, periods_per_year=None) SimulationResult$
        +estimate_parameters(returns, periods_per_year) DataFrame$
    }
    class SimulationResult {
        <<dataclass>>
        +paths : DataFrame
        +assumptions : DataFrame
        +correlation : DataFrame
        +valuation_date : Timestamp
        +currency : str
        +rebalance_interval : int?
        +rebalance_rule : RebalanceRule?
        +commissions : Series?
        +/mean_commissions : float
        +estimation_start : Timestamp?
        +estimation_end : Timestamp?
        +summary() Series
        +plot(show, max_paths) Figure
    }
    class commissions {
        <<module>>
        +rebalance_step(values, target, rule) RebalanceStep$
    }
    class frequency {
        <<module>>
        +periods_per_year(dates) int$
    }
    class reporting {
        <<package>>
        +plot_simulation(result) Figure
    }
    Asset ..> SimulationInputs : crea para una unidad
    Portfolio ..> SimulationInputs : crea para sus posiciones
    Asset ..> monte_carlo : delega
    Portfolio ..> monte_carlo : delega
    Asset ..> SimulationSettings : from_options()
    Portfolio ..> SimulationSettings : from_options()
    monte_carlo ..> SimulationInputs : lee y valida
    monte_carlo ..> SimulationSettings : utiliza
    monte_carlo ..> SimulationResult : crea
    monte_carlo ..> commissions : rebalance_step() en cada reajuste
    monte_carlo ..> frequency : 252 o 365 si no se indica
    SimulationResult ..> reporting : plot() importa al llamar
    note for monte_carlo "GBM correlacionado. Cholesky o autovalores.\nRebalanceo opcional con comisiones. Sin red ni exportación."
    note for SimulationInputs "Contrato común para activo y cartera.\nNo contiene el proveedor de precios.\nprices puede venir de estimation_prices:\nσ y correlaciones de otro período;\nvalor inicial y pesos, de la cartera."
    note for SimulationSettings "Supuestos comunes o por activo.\nSin supuesto: estimación histórica.\nSin steps: un año de sesiones."
    note for commissions "La misma regla que backtest_with_costs().\nLas comisiones se descuentan de paths."
