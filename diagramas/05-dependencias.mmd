%% Imports internos extraídos del AST. Tres vistas separadas evitan confundir
%% importación al cargar un módulo, importación al llamar y anotaciones de tipos.
%%{init: {"flowchart":{"curve":"basis","nodeSpacing":30,"rankSpacing":50}}}%%
flowchart TB
    accTitle: B1-T1 · Dependencias entre paquetes
    accDescr: Imports de módulo sin ciclos, imports diferidos de conveniencia e imports exclusivos de TYPE_CHECKING.
    subgraph MODULE["A · IMPORTS DE MÓDULO · grafo acíclico"]
        direction TB
        M["main"]
        PL["portfolio_loader"]
        ML["market_loader"]
        P["providers"]
        D["models"]
        A["analysis"]
        S["simulation"]
        R["reporting"]
        M --> PL
        M --> ML
        M --> P
        M --> D
        M --> A
        M --> S
        M --> R
        PL --> ML
        PL --> P
        PL --> D
        ML --> P
        ML --> D
        P --> D
        A --> D
        A --> S
        D --> S
        R --> A
        R --> S
        R --> P
    end
    subgraph DEFERRED["B · IMPORTS DIFERIDOS · al llamar al método"]
        direction LR
        DD["models"]
        DA["analysis"]
        DS["simulation"]
        DR["reporting"]
        DD -. "Portfolio.analyze()" .-> DA
        DD -. "Portfolio.report(): sections" .-> DR
        DA -. "markdown() · report()<br/>plot() · plots_report()" .-> DR
        DS -. "SimulationResult.plot()" .-> DR
    end
    subgraph TYPES["C · TYPE_CHECKING · solo anotaciones, sin import runtime"]
        direction LR
        TD["models"]
        TA["analysis"]
        TS["simulation"]
        TR["reporting"]
        TD -. "tipos" .-> TA
        TA -. "tipos" .-> TD
        TR -. "tipos" .-> TA
        TR -. "tipos" .-> TS
    end
    CORE["Infraestructura transversal<br/>constants · errors · validation<br/>commissions · frequency<br/>validation importa constants y errors"]
    linkStyle 19,20,21,22 stroke:#7953BF,stroke-width:2px,stroke-dasharray:7 4;
    linkStyle 23,24,25,26 stroke:#BF861B,stroke-width:1.5px,stroke-dasharray:2 4;

%% Imports transversales omitidos visualmente:
%% origen           | constants | errors | validation | commissions | frequency
%% main             | sí        | sí     | sí         | sí          | no
%% portfolio_loader | sí        | sí     | sí         | sí          | no
%% market_loader    | sí        | sí     | no         | no          | no
%% providers        | sí        | sí     | sí         | no          | no
%% models           | sí        | sí     | sí         | sí          | no
%% analysis         | sí        | sí     | sí         | sí          | sí
%% simulation       | sí        | sí     | sí         | sí          | sí
%% reporting        | sí        | sí     | sí         | sí          | no
%% validation       | sí        | sí     | --         | no          | no
%% commissions      | no        | sí     | sí         | --          | no
%% frequency        | sí        | no     | no         | no          | --
%% reporting importa al cargar analysis (métricas, avisos), simulation (supuestos)
%% y providers (identificador de la serie del BCE).
%% constants y errors no importan otros paquetes internos.
%% reporting → providers solo toma la etiqueta AAA_3M_YIELD de providers.ecb.
%% 4 aristas diferidas = 7 sentencias de importación.
%% Los imports internos dentro del mismo paquete no se representan.
